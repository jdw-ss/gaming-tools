<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WondrousTailsOdds - personal Dalamud plugin that overlays
    row/column/diagonal completion probabilities onto FFXIV's weekly
    Wondrous Tails journal. Independent clean-room implementation,
    MIT licensed, written against current Dalamud API.

    Source folder is still named WondrousTailsSolver/ for historical
    continuity (the project started under that name before we discovered
    a maintained d17 plugin already owned the WondrousTailsSolver
    InternalName). The shipping artefact is WondrousTailsOdds.dll +
    WondrousTailsOdds.json; AssemblyName and the manifest filename
    were renamed in v0.1.1 to avoid the d17 collision. RootNamespace
    stays WondrousTailsSolver because nothing user-facing depends on
    it and a global namespace rename has no value.

    Build:
      dotnet build -c Release

    Targets net10.0-windows because Dalamud 14.x+ is built against .NET 10.
    Install the .NET 10 SDK from https://dotnet.microsoft.com/download/dotnet/10.0
    if the `dotnet` CLI's SDK listing command shows no 10.x entry. Note:
    avoid double dashes inside this XML comment block; XML parsers reject them.

    DalamudLibPath auto-detection order:
      1. Local `.refs/` folder shipped with source (for macOS / Linux / CI).
      2. Standard %AppData%\XIVLauncher\addon\Hooks\dev\ (Windows + XIVLauncher).
      3. Explicit override via the DalamudLibPath property on the dotnet CLI.

    No KamiToolKit dependency as of v0.1.2: the v0.1 plan rendered the
    overlay as a native AtkTextNode injected into AddonWeeklyBingo via
    KamiToolKit, but the result clipped the addon's title bar. v0.1.2
    drops that approach entirely in favour of a Dalamud ImGui Window
    anchored to the left edge of the addon, which is both more legible
    and much cheaper to maintain. KamiToolKit and its transitive
    SixLabors.ImageSharp + Microsoft.Extensions.ObjectPool refs are gone.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>WondrousTailsOdds</AssemblyName>
    <RootNamespace>WondrousTailsSolver</RootNamespace>
    <Version>0.1.3</Version>
    <!-- Required to dereference PlayerState / AddonWeeklyBingo pointers from
         FFXIVClientStructs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Allow building net10.0-windows TFM from non-Windows hosts. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' AND Exists('$(MSBuildThisFileDirectory).refs/Dalamud.dll')">$(MSBuildThisFileDirectory).refs/</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="WondrousTailsOdds.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
